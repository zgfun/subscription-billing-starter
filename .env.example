# Local: pnpm db:local (Postgres on port 5435). Production: a Neon connection string.
DATABASE_URL=postgres://billing:billing@localhost:5435/billing
# Separate database for DB-backed tests (they insert and delete rows). pnpm db:local creates it.
TEST_DATABASE_URL=postgres://billing:billing@localhost:5435/billing_test
# Optional: Neon's direct (unpooled) URL, used by drizzle-kit for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Stripe TEST-mode keys (this project is a demo; it refuses live keys).
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --print-secret` locally, or the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# Customer Portal configuration created by `pnpm stripe:setup` (it writes this line). Set it in production too.
# STRIPE_PORTAL_CONFIG_ID=bpc_...

# Signs the demo session cookie (openssl rand -hex 32).
SESSION_SECRET=
# Public base URL, used for Checkout success/cancel and portal return URLs.
APP_URL=http://localhost:3000

# Optional: global cap on new demo users per hour (default 200).
# DEMO_HOURLY_CAP=200
# Optional: set to 1 only behind a proxy that overwrites X-Forwarded-For. Vercel is detected automatically.
# TRUST_PROXY=

# Optional: dunning emails via Resend. Skipped when unset.
RESEND_API_KEY=
EMAIL_FROM=
# Without a verified domain Resend only delivers to the account owner, so dunning emails go here.
DUNNING_EMAIL_OVERRIDE=
