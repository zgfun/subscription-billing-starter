# Local: pnpm db:local (Postgres on port 5435). Production: a Neon connection string.
DATABASE_URL=postgres://billing:billing@localhost:5435/billing
# Separate database for DB-backed tests (they insert and delete rows).
TEST_DATABASE_URL=

# Stripe TEST-mode keys (this project is a demo; never put live keys here).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --print-secret` locally, or the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Signs the demo session cookie (openssl rand -hex 32).
SESSION_SECRET=
# Public base URL, used for Checkout success/cancel and portal return URLs.
APP_URL=http://localhost:3000

# Optional: dunning emails via Resend. Skipped when unset.
RESEND_API_KEY=
EMAIL_FROM=
# Without a verified domain Resend only delivers to the account owner, so dunning emails go here.
DUNNING_EMAIL_OVERRIDE=
